{
  "info": {
    "name": "FundsRoom ERP/CRM API",
    "description": "Complete API collection for FundsRoom Mini ERP + CRM.\n\nRun **Auth → Login** first — the Pre-request Script on that request stores the JWT so all subsequent requests use it automatically.\n\nBase URL: https://funds-room-project.onrender.com/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://funds-room-project.onrender.com/api" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@fundsroom.com\",\"password\":\"password123\"}" },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var res = pm.response.json();",
                    "if (res.success && res.data && res.data.token) {",
                    "  pm.environment.set('token', res.data.token);",
                    "  console.log('Token saved for ' + res.data.user.role);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Login (Sales)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"sales@fundsroom.com\",\"password\":\"password123\"}" },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var res = pm.response.json();",
                    "if (res.success && res.data && res.data.token) {",
                    "  pm.environment.set('token', res.data.token);",
                    "  console.log('Token saved for ' + res.data.user.role);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Login (Warehouse)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"warehouse@fundsroom.com\",\"password\":\"password123\"}" },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var res = pm.response.json();",
                    "if (res.success && res.data && res.data.token) {",
                    "  pm.environment.set('token', res.data.token);",
                    "  console.log('Token saved for ' + res.data.user.role);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Login (Accounts)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"accounts@fundsroom.com\",\"password\":\"password123\"}" },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var res = pm.response.json();",
                    "if (res.success && res.data && res.data.token) {",
                    "  pm.environment.set('token', res.data.token);",
                    "  console.log('Token saved for ' + res.data.user.role);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["customers"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/customers", "host": ["{{baseUrl}}"], "path": ["customers"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Ravi Traders\",\"mobile\":\"9876543210\",\"email\":\"ravi@example.com\",\"businessName\":\"Ravi Traders Pvt Ltd\",\"customerType\":\"WHOLESALE\",\"address\":\"Mumbai, Maharashtra\"}"
            }
          }
        },
        {
          "name": "Get Customer",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"status\":\"ACTIVE\"}" }
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}"] }
          }
        },
        {
          "name": "Add Follow-Up",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/customers/{{customerId}}/follow-ups", "host": ["{{baseUrl}}"], "path": ["customers", "{{customerId}}", "follow-ups"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"note\":\"Spoke with manager, interested in bulk order\"}" }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Widget A\",\"sku\":\"WGT-001\",\"category\":\"Widgets\",\"unitPrice\":250,\"currentStock\":200,\"minStockAlert\":20,\"location\":\"Warehouse A\"}"
            }
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"unitPrice\":299}" }
          }
        },
        {
          "name": "Log Stock Movement",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/products/{{productId}}/stock", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "stock"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"quantityChanged\":50,\"movementType\":\"IN\",\"reason\":\"Restock from supplier\"}" }
          }
        },
        {
          "name": "Get Stock Movements",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/stock-movements?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["products", "stock-movements"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Low Stock Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/low-stock", "host": ["{{baseUrl}}"], "path": ["products", "low-stock"] }
          }
        }
      ]
    },
    {
      "name": "Challans",
      "item": [
        {
          "name": "List Challans",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/challans?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["challans"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Create Challan",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/challans", "host": ["{{baseUrl}}"], "path": ["challans"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"customerId\":\"{{customerId}}\",\"items\":[{\"productId\":\"{{productId}}\",\"quantity\":10}]}"
            }
          }
        },
        {
          "name": "Get Challan",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/challans/{{challanId}}", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}"] }
          }
        },
        {
          "name": "Confirm Challan",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/challans/{{challanId}}/confirm", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}", "confirm"] }
          }
        },
        {
          "name": "Cancel Challan",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/challans/{{challanId}}/cancel", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}", "cancel"] }
          }
        },
        {
          "name": "Download Invoice PDF",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/challans/{{challanId}}/invoice", "host": ["{{baseUrl}}"], "path": ["challans", "{{challanId}}", "invoice"] }
          }
        },
        {
          "name": "Dashboard Stats (Auth)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/challans/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["challans", "dashboard", "stats"] }
          }
        },
        {
          "name": "Public Stats (No Auth)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/challans/public/stats", "host": ["{{baseUrl}}"], "path": ["challans", "public", "stats"] },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Users (Admin Only)",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"New User\",\"email\":\"newuser@fundsroom.com\",\"password\":\"password123\",\"role\":\"SALES\"}" }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Updated Name\"}" }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "auth": { "type": "noauth" }
          }
        }
      ]
    }
  ]
}
